    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-components": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260909822",
    "dayjs": "^1.11.23",
    "pinia": "^2.3.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-1000920260909822",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260909822",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.5.1",
    "sass": "^1.83.0",
    "typescript": "^5.4.0",
    "vite": "8.2.2",
    "vue-tsc": "^2.1.6"
  }
