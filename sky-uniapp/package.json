{
  "name": "sky-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "苍穹外卖用户端小程序(uni-app Vue3 + TS),对接 sky-backend 的 /user 接口",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
