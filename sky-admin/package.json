{
  "name": "sky-admin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "苍穹外卖管理端 (Vite 8 + Vue 3 + Element Plus)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,scss}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,scss}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.10.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.14.5",
    "js-cookie": "^3.0.5",
    "md5": "^2.3.0",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.13.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.6",
    "sass": "^1.90.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
